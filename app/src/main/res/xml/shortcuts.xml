<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_task"
        android:enabled="true"
        android:icon="@drawable/ic_launcher_foreground"
        android:shortcutShortLabel="@string/shortcut_new"
        android:shortcutLongLabel="@string/shortcut_new_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.emmanuel.calendarrescheduler"
            android:targetClass="com.emmanuel.calendarrescheduler.MainActivity"
            android:data="schedule://app/go?to=create" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
    <shortcut
        android:shortcutId="focus"
        android:enabled="true"
        android:icon="@drawable/ic_launcher_foreground"
        android:shortcutShortLabel="@string/shortcut_focus"
        android:shortcutLongLabel="@string/shortcut_focus_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.emmanuel.calendarrescheduler"
            android:targetClass="com.emmanuel.calendarrescheduler.MainActivity"
            android:data="schedule://app/go?to=focus" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
</shortcuts>
