<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:background="#ff1a1f2e"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⏰"
        android:textSize="58sp"
        android:layout_marginBottom="18dp"/>

    <TextView
        android:id="@+id/alarm_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#ffffff"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="12dp"
        android:maxLines="3"
        android:ellipsize="end"/>

    <TextView
        android:id="@+id/alarm_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#aab8cc"
        android:textSize="15sp"
        android:gravity="center"
        android:maxLines="4"
        android:ellipsize="end"
        android:layout_marginBottom="34dp"/>

    <Button
        android:id="@+id/btn_alarm_reschedule"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Reschedule"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#2563eb"
        android:textColor="#ffffff"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btn_alarm_snooze"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Snooze 10 min"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#7c3aed"
        android:textColor="#ffffff"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btn_alarm_open"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Open in app"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#4f46e5"
        android:textColor="#ffffff"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btn_alarm_dismiss"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Dismiss"
        android:textSize="14sp"
        android:backgroundTint="#374151"
        android:textColor="#d1d5db"/>

</LinearLayout>